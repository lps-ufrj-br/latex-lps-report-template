@Article{s25185846,
AUTHOR = {Costa da Silva, Nelson Victor and Albuquerque Pontes, Flavia and Santos da Silva, Mariana and Cagide Fialho, Breno and Eleutério Delesposte, Jamile and Garcia Borges de Souza, Dalton and de Oliveira Chaves, Luiz Antônio and Cardoso, Rodolfo},
TITLE = {Leveraging FMMEA for Digital Twin Development: A Case Study on Intelligent Completion in Oil and Gas},
JOURNAL = {Sensors},
VOLUME = {25},
YEAR = {2025},
NUMBER = {18},
ARTICLE-NUMBER = {5846},
URL = {https://www.mdpi.com/1424-8220/25/18/5846},
PubMedID = {41013084},
ISSN = {1424-8220},
ABSTRACT = {The implementation of Digital Twins (DTs) represents a significant advancement for the Oil and Gas (O&G) industry. A DT virtually replicates a physical asset, enabling the monitoring, diagnosis, prediction, and optimization of its outcomes. Since failures are undesirable outcomes, investigations into potential failure modes are often integrated into the development. Traditional methods, such as Failure Modes and Effects Analysis (FMEA) and Failure Mode, Effects, and Criticality Analysis (FMECA), are widely used to identify, assess, and mitigate risks. However, there is still a lack of specific guidelines for studying potential failures in complex systems. This article introduces a framework for Failure Modes, Mechanisms, and Effects Analysis (FMMEA) as a tool for identifying and assessing failures in early DT development. Exploring failure mechanisms is highlighted as essential for effective prediction and management We also propose adjustments to FMMEA for complex, predictable systems, such as using a DPR (Detectable Priority Risk) instead of RPN (Risk Priority Number) for prioritizing risks. A comprehensive case illustrates the framework’s application in developing a DT for an intelligent completion system in a major O&G company. The approach enables mechanism-oriented failure analysis and more detailed prognostic health management, providing greater transparency in the failure identification process.},
DOI = {10.3390/s25185846}
}


@proceedings{10.2523/IPTC-24783-EA,
    author = {Siegmund, Mark and Meziou, Amine and Meraz, Jose},
    title = {The Emergence of the Subsea BOP Digital Twin Using Process Safety Management \&amp; Big Data},
    volume = {International Petroleum Technology Conference},
    series = {IPTC International Petroleum Technology Conference},
    pages = {D031S037R001},
    year = {2025},
    month = {02},
    abstract = {The process safety approach to manage Subsea Blow Out Preventer (BOP) performance risks over a 5 year period has seen the successful emergence and application of cloud based Real Time Monitoring (RTM) underpinned by advanced Fault Tree Engineering and Digital Analytics. The performance data collected was used to prove physics-based models to estimate component residual life and to uncover incipient signals that can indicate the onset of failure whereas historically such failures remain hidden until suddenly failing catastrophically. Key functions to Annular Rams, Pipe Rams, and valves were modelled to determine overall integrity and even to predict near-term component failures.All BOP Pressure and Function testing was digitally performed and measurably compared with previous results to determine areas for early degradation, but there remained gaps in BOP data collected between well programs on maintenance and testing activities; especially for the spare BOP if the rig had 2 BOP's.A pilot exercise with an edge-based kiosk was deployed to the rig to allow the BOP Subsea team to integrate the touch screen device into their post maintenance tests on the BOP(s) and to digitally confirm the spare BOP's functional integrity. The summary of all digital data was incorporated in Condition-based Maintenance (CBM) reports and maintenance management programs, completing the realization of a Digital Twin for the Subsea BOP(s).As the work progressed it became evident that the real time advanced digital analytics and dynamic modeling would also help to overcome human factors risks identified during initial process safety management assessments. The third-party RTM oversight facility was able to immediately discover procedural errors during tests and operations that historically weren't noticed, measurable, or accessible to the BOP team. The human factors risk improved even more with the onboard digital kiosk as the subsea BOP team could now perform digital testing using the same built-in logic and automation to confirm test processes and deliver test results without the historical human errors that can occur when crews are under time stress or performing under the burden of many simultaneous activities.},
    doi = {10.2523/IPTC-24783-EA},
    url = {https://doi.org/10.2523/IPTC-24783-EA},
    eprint = {https://onepetro.org/IPTCONF/proceedings-pdf/25IPTC/25IPTC/D031S037R001/4563302/iptc-24783-ea.pdf},
}


@proceedings{10.2118/223819-MS,
    author = {Cao, Jie and Gocmen, Emre and Nabavi, Josef and Oedegaard, Sven Inge and Kristiansen, Tron Golder and Khosravanian, Rasool and Solem, Kristian},
    title = {Optimizing Drilling Operations in Real-Time: The Role of Digital Twins in Reducing Risks and Enhancing Performance},
    volume = {SPE/IADC International Drilling Conference and Exhibition},
    series = {SPE/IADC Drilling Conference and Exhibition},
    pages = {D011S007R005},
    year = {2025},
    month = {03},
    abstract = {This paper presents an innovative approach to optimize drilling operations in real-time, offering enhanced risk management, improved efficiency and cost reduction. The focal point is an automated rate of penetration (ROP) optimization system powered by digital twins and artificial intelligence (AI) technologies, which effectively enhances drilling performance while mitigating potential issues.At the core of this system are digital twins continuously calibrated using real-time data, a risk detection module leveraging model-based reasoning in AI and a fast auto-optimization module. It incorporates predictive analytics and multiple what-if scenarios to propose forward-looking advice on potential risks and operational parameters. To enhance performance while reducing risks, the system evaluates imminent risks and anticipated hole-cleaning requirements for ROP optimization.The effectiveness of the advisory system has been rigorously tested and verified, with a specific focus on risk detection and auto-optimization modules. As shown in the case studies, the system automatically detects potential risks including poor hole cleaning, poor cuttings transport, and a leakage or washout in real-time operations. Moreover, it optimizes real-time drilling parameters by evaluating multiple scenarios on combined objectives of reducing potential drilling risks, ensuring hole cleanness, and improving drilling efficiency, ensuring the optimized results are risk-free in pursuing higher ROP. It results in substantial time savings, with up to 4.75 hours saved during a single drilling section. The results clearly demonstrate the value created through reduced drilling time, empowering the rig team to operate independently and minimizing reliance on back-office support.Overall, this real-time optimization system offers a transformative approach to drilling operations, yielding significant time and cost reductions. Its supervisory capabilities streamline the implementation of advanced digital twin models and parameter optimization, thereby improving operational performance and driving further integrated drilling automation.},
    doi = {10.2118/223819-MS},
    url = {https://doi.org/10.2118/223819-MS},
    eprint = {https://onepetro.org/SPEDC/proceedings-pdf/25DC/25DC/D011S007R005/4583282/spe-223819-ms.pdf},
}


@Article{pr13082575,
AUTHOR = {Stoicescu, Alexandru-Adrian and Ripeanu, Razvan George and Tănase, Maria and Ilincă, Costin Nicolae and Toader, Liviu},
TITLE = {Multifactorial Analysis of Defects in Oil Storage Tanks: Implications for Structural Performance and Safety},
JOURNAL = {Processes},
VOLUME = {13},
YEAR = {2025},
NUMBER = {8},
ARTICLE-NUMBER = {2575},
URL = {https://www.mdpi.com/2227-9717/13/8/2575},
ISSN = {2227-9717},
ABSTRACT = {This article investigates the combined effects of different common defects on the structural integrity and operational and environmental safety in the operation of an existing Light Cycle Oil (LCO) storage tank. This study correlates all the tank defects (like corrosion and local plate thinning, deformations, and local stress concentrators) against the loads and their combinations that occur during the tank’s lifetime. All the information gathered by various inspection techniques is used together to create a digital twin of the equipment that will be further analyzed by Finite Element Analysis. A tank condition assessment is a complex activity, and it is based on the experience of the engineer performing it. Since there are multiple methods for performing a comprehensive analysis, starting from the basic visual inspection (which is the most important) and some measurements followed by analytical calculations, up to full wall thickness measurements, 3D scan of deformations and FEA analysis of the tank digital twin, it depends on the engineer performing the evaluation to chose the best method for each particular case from technical and economical point of views. The goal of this article is to demonstrate that analytical and FEA methods have the same result and also to establish a well-determined standard calculation model for future applications.},
DOI = {10.3390/pr13082575}
}


@proceedings{10.2118/226618-MS,
    author = {Dirya, D. and Cowie, G. and Thornton, S. and Annand, D.},
    title = {Rejuvenating a Late-Life Offshore Field Through Hydraulic Fracturing: The Successful Case History from North Alwyn},
    volume = {SPE International Hydraulic Fracturing Technology Conference and Exhibition},
    series = {SPE International Hydraulic Fracturing Technology Conference and Exhibition},
    pages = {D011S002R002},
    year = {2025},
    month = {09},
    abstract = {The Alwyn North Field is located 465 km north-east of Aberdeen. The Alwyn North Triassic Reservoir has consistently presented challenges due to its disconnected, low-permeability sand bodies, with nearly 60\% of the reservoir possessing permeability below 1mD. Being the deepest and most complex of the Alwyn reservoirs, the Triassic's low permeability can result in wells being constrained by their productivity. Consequently, hydraulic fracturing has been seen, both historically and recently, as a way to maximize its recovery.A total of six wells were hydraulically fractured between 1998 and 2003 before a significant gas release, attributed to the clean-up of a frac well, halted further fracturing attempts. The gas release, combined with strong production from other fields on Alwyn, and a depressed gas price meant that hydraulic fracturing was not performed at Alwyn again until 2024. The strategic decision to concentrate efforts on N57 and N58Z was influenced by the unique challenges presented by these wells. N57, once a strong producer, declined significantly in 2021 after a re-perforation intervention caused clay particles to obstruct the reservoir and effectively kill the most productive zone. N58Z was drilled in 2022 in a new panel which found lower permeability than prognosed and subsequently underperformed. Both wells then became ideal candidates for hydraulic fracturing.The fracturing designs refined the fracture half-length in N57 to address 194m of open perforation intervals with variable permeability and pressure layers, and limit N58's fracture half-length to avoid intersecting the nearby mother-bore well or water zones. The flowback design featured a cyclone for initial proppant separation, a dual filtration unit, a multi-phase flow meter (MPFM) for real-time monitoring, and two solid detection sensors: acoustic and intrusive.The fracturing campaign timeline was accelerated and based on the availability of fully booked stimulation vessels schedule across two service providers. An 8-day window in September, though not ideal for North Sea operations, was secured. The operation was integrated into a busy platform schedule and required close coordination with the offshore team and asset planners to allow simultaneous works of drilling completion, a platform pit-stop, and a flare tip change out. Key aspects included optimising the timeline, using space on the BOP deck, pipe deck, and rig floor, and scheduling personnel on board.The campaign was executed successfully without any incidents or accidents, resulting in a significant increase in production. The contributions of N57 and N58Z added significant reserves and raised Alwyn's areas output by one third whilst providing valuable insights for future fracturing operations. This case history of remedial offshore fracture stimulation addresses in detail the challenges, engineering, execution and resulting production success of this campaign.},
    doi = {10.2118/226618-MS},
    url = {https://doi.org/10.2118/226618-MS},
    eprint = {https://onepetro.org/SPEIHFT/proceedings-pdf/25IHFT/25IHFT/D011S002R002/5264389/spe-226618-ms.pdf},
}


@proceedings{10.2118/229000-MS,
    author = {Karpov, R. and Zakirov, K.},
    title = {Dynamic Digital Twin-Driven Auto-Drilling: A New Era in Automated Well Construction},
    volume = {ADIPEC},
    series = {Abu Dhabi International Petroleum Exhibition and Conference},
    pages = {D031S121R004},
    year = {2025},
    month = {11},
    abstract = {This article presents a cutting-edge approach to automated drilling, integrating an auto-driller system with advanced ecosystem powered by dynamic digital twin, to optimize drilling performance in real time. The methodology enables continuous adjustment of operational parameters based on actual wellbore conditions, significantly enhancing drilling efficiency, safety, and risk mitigation. By identifying operational sweet spots and automating critical processes, the system delivers substantial improvements in key performance indicators (KPIs). The paper includes implementation results and a comparative analysis, demonstrating the effectiveness of this intelligent ecosystem in modern well delivery.The ecosystem provides functionality for pre-drilling planning and real-time execution phases. During the planning phase, a detailed drilling roadmap is created within the ecosystem, where operational parameters are validated through risk assessments and mechanical/hydraulic modeling to ensure wellbore and drillstring integrity. These verified parameters serve as target values for the auto-driller during execution.In the operational phase, a dynamic digital twin continuously assesses wellbore conditions, calculates optimal operational parameters, and updates the roadmap accordingly. Real-time outputs—including setpoints for on- and off-bottom activities—are transmitted directly to the OEM Programmable Logic Controllers (PLCs), enabling fully unmanned and automated drilling. The system proactively detects the severity of drilling malfunctions and anticipates potential hazards, ensuring that key risks are mitigated at an early stage. Additionally, the auto-driller operates under a predefined control algorithm, which includes: automated operations sequence with continuous monitoring and adaptation based on current wellbore conditions. The drill-ahead module automatically defines the targeted toolface orientation for slide mode execution to follow the planned trajectory.Implementing pre-drill planning within the ecosystem enables the selection of downhole equipment, identification of optimal drilling parameters, and estimation of expected ROP, taking into account the analysis of efficiency from previous offset wells drilling operations. Leveraging the ecosystem to control an auto-driller guarantees the execution of technological operations under optimal conditions. Wellbore, drilling equipment states are continuously and automatically evaluated in real-time by dynamic digital twin. Rock cutting process and Wellbore treatment efficiency, safe operational envelop and drilling dysfunction risks are automatically evaluated along the execution. Well construction cycle improvements exceed 30\% of the conventional drilling and predefined lookup auto-drilling techniques for similar wells. Using the drill ahead module has reduced sliding time by up to 10\%. NPTs and ILTs losses were decreased by operating in the actual safe operational zone and mitigating at an early state downhole hazards such as: micro influxes and mud losses, pack-offs, stuck pipe, premature drilling tools wear, etc. and BHA overloads due to excessive torsional and lateral vibrations stick. The digital twin 1hz frequency automated analysis identified all precursors of upcoming hole condition deterioration: deviation of slack off weights and micro overpulls, automatically identifies FFs and generates sensitivity trend analysis, notifying key personnel, generating reports, and setting values to swiftly achieve optimal states.The applied methodology proves its viability and effectiveness in well construction, particularly in settings with constrained operational pathways. Integrating the ecosystem that merges well design and real-time analysis with auto-driller systems presents an opportunity to deploy innovative process management techniques to achieve consistent improvements throughout available equipment. The integration of the digital ecosystem can seamlessly span across a diverse range of drilling systems, offering unprecedented flexibility to harness hybrid AI and physics-based insights.},
    doi = {10.2118/229000-MS},
    url = {https://doi.org/10.2118/229000-MS},
    eprint = {https://onepetro.org/SPEADIP/proceedings-pdf/25ADIP/25ADIP/D031S121R004/5282864/spe-229000-ms.pdf},
}


@proceedings{10.2118/213726-MS,
    author = {Hummes, Olof and Macpherson, John D. and Bone, Kimberley and Marwah, Gaurav and Arévalo, Pedro and Forshaw, Matthew},
    title = {Executing the Digital Well Plan - Enhancing Process Automation},
    volume = {Middle East Oil, Gas and Geosciences Show},
    series = {SPE Middle East Oil and Gas Show and Conference},
    pages = {D031S101R004},
    year = {2023},
    month = {02},
    abstract = {Automation of well construction combines process and machine automation to deliver cost savings and efficiency gains, alongside safer operations and faster collaborative decision making. Integration of well planning and execution improves performance, minimizes risk, and creates the framework for batch control of well construction. Generating intuitive and standardized insights from historical and live data streams enables reducing uncertainty and driving technical limit performance at every stage, for the safest and most economical well delivery possible.Remote operations have become standard practice in well construction and drilling automation is rapidly growing. Machine-learning based models can predict hazards and best operating parameters. The paper describes how these elements are combined to easily analyze offset well data from multiple sources for performance benchmarking, deep technical analysis, and risk management. Integration with physics-based models (the digital-twin) establishes a coherent execution roadmap, a real-time digital recipe that is directly used in rigsite automation. During execution, model assumptions are replaced by live sensor data. Those models are then re-calculated in real-time for automated process control and become available for future planning.The viability of integrated well planning and automation systems is no longer disputed, and industry focus has shifted towards proving the potential of this approach. Pertinent case examples from drilling operations are examined in the paper, including optimizing performance through harnessing analytics of large data sets from offset wells, and on exploring the integration of AI techniques for risk prediction and mitigation. The insights gained, coupled with the digital well plan, are instrumental for optimization and automation of tripping equipment in and out of hole, and of drilling ahead operations.Integrating the digital well plan with "lessons learned" from the analysis of all available data and using a digital-twin concept with physics-based and data driven models, provides the foundation for the next step in process automation: the creation of digital procedures for process automation of well construction. This capability extends the cost savings and efficiency gains realized in recent years through remote operations.},
    doi = {10.2118/213726-MS},
    url = {https://doi.org/10.2118/213726-MS},
    eprint = {https://onepetro.org/SPEMEOS/proceedings-pdf/23MEOS/23MEOS/D031S101R004/4114306/spe-213726-ms.pdf},
}


@Article{pr13113488,
AUTHOR = {Hamidishad, Nayereh and Barbosa, Rafael Silverio and Allahyarzadeh-Bidgoli, Ali and Yanagihara, Jurandir Itizo},
TITLE = {Digital Twin Frameworks for Oil and Gas Processing Plants: A Comprehensive Literature Review},
JOURNAL = {Processes},
VOLUME = {13},
YEAR = {2025},
NUMBER = {11},
ARTICLE-NUMBER = {3488},
URL = {https://www.mdpi.com/2227-9717/13/11/3488},
ISSN = {2227-9717},
ABSTRACT = {Digital Twin (DT) technology has rapidly matured from pilot projects to integral components of advanced asset management and process optimization in the oil and gas (O&G) industry. This review provides a structured synthesis of the current state of digital twin frameworks, with a focus on offshore and topside gas-processing systems, such as those found on Floating Production Storage and Offloading (FPSO). Emphasis is placed on high-fidelity process simulations and scalable architectures integrating real-time data with advanced analytics. Drawing on over 85 peer-reviewed sources and industrial frameworks, the paper outlines modular DT architectures, encompassing steady-state and dynamic process simulations (e.g., Aspen HYSYS), reduced-order and hybrid machine learning models, co-simulation environments, and advanced equation-of-state packages (e.g., GERG-2008). Special attention is given to compressor map integration, Equations of State (EOS) selection, ISO/IEC standard compliance, and digital thread continuity. Additionally, the review explores economic and sustainability-driven DT implementations, including flare and methane mitigation, ISO 50001-aligned energy optimization, and lifecycle/decommissioning strategies. It concludes with a technical and economic assessment of DT maturity for gas compression facilities, identifying research gaps in standardization, long-term validation, and cybersecurity integration. The insights provided are intended to support decision-makers, engineers, and researchers in deploying scalable, auditable, and high-impact DT solutions across the O&G value chain.},
DOI = {10.3390/pr13113488}
}



